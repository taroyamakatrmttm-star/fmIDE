  },
  {
   "family": "family-escalate",
   "version": 1,
   "versionId": "version-escalate-1",
   "text": "Escalate(base, g) = base * (1 + g) ^ (PERIOD() - 1)",
   "description": "",
   "note": "",
   "calls": []
  },
  {
   "family": "family-rounds",
   "version": 1,
   "versionId": "version-rounds-1",
   "text": "Rounds(x) = ROUND(x, 2) + ROUNDUP(x, 0) * 10 - ROUNDDOWN(x, -1)",
   "description": "",
   "note": "",
   "calls": []
  },
  {
   "family": "family-safediv",
   "version": 1,
   "versionId": "version-safediv-1",
   "text": "SafeDiv(a, b) = IF(b = 0, 0, a / b)",
   "description": "",
   "note": "",
   "calls": []
  },
  {
   "family": "family-pick",
   "version": 1,
