   "note": "",
   "calls": []
  },
  {
   "family": "family-flags",
   "version": 1,
   "versionId": "version-flags-1",
   "text": "Flags(a, b) = AND(a > 0, b > 0) + OR(a > 0, b > 0) * 10 + NOT(a > 0) * 100 + (a = b) * 1000",
