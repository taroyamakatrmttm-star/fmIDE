        "Model": {
          "headerRow": 3, "periodColumns": ["D", "E", "F", "G", "H"], "periods": ["2026", "2027", "2028", "2029", "2030"],
          "labelColumn": "A", "unitColumn": "B",
          "rows": [
            { "row": 1, "label": "Simple profit model", "kind": "title" },
            { "row": 5, "label": "Revenue", "kind": "title" },
            { "row": 6, "label": "Volume", "kind": "input" },
            { "row": 7, "label": "Price", "kind": "input" },
            { "row": 8, "label": "Revenue", "kind": "calculation", "formula": "Volume × Price" },
            { "row": 10, "label": "Costs", "kind": "title" },
            { "row": 11, "label": "Cost rate", "kind": "input" },
            { "row": 12, "label": "Costs", "kind": "calculation", "formula": "Revenue × Cost rate" },
            { "row": 14, "label": "Profit", "kind": "calculation", "formula": "Revenue − Costs" }
          ]
        }
      },
      "notTranslated": []
    },
    "02-corkscrew": {
