            { "row": 8, "label": "Additions", "kind": "input" },
            { "row": 9, "label": "Depreciation", "kind": "calculation", "formula": "Opening balance × Depreciation rate" },
            { "row": 10, "label": "Closing balance", "kind": "calculation", "formula": "Opening balance + Additions − Depreciation" }
          ]
        }
