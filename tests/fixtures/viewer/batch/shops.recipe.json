{
 "kind": "fmIDE-showcase",
 "version": 1,
 "form": "recipe",
 "title": "{model}: the shop",
 "description": "Move the price and watch the profit.",
 "author": "A teacher",
 "licence": "CC BY 4.0",
 "canvases": {
  "show": [
   "Shop",
   "Summary",
   "Nowhere"
  ],
  "start": "Shop"
 },
 "boards": {
  "kind": "fmIDE-graph-board",
  "version": 2,
  "form": "template",
  "template": {
   "kind": "system"
  },
  "boards": [
   {
    "name": "The shop",
    "items": [
     {
      "type": "bar",
      "canvas": "Shop",
      "name": "Profit",
      "periods": {
       "mode": "all"
      },
      "wide": false
     },
     {
      "type": "bar",
      "name": "Margin",
      "periods": {
       "mode": "all"
      },
      "wide": false
     },
     {
      "type": "chart",
      "layout": "columns",
      "title": "Revenue and costs",
      "periods": {
       "mode": "all"
      },
      "groups": [
       {
        "name": "Money",
        "parts": [
         {
          "canvas": "Shop",
          "name": "Revenue"
         },
         {
          "canvas": "Shop",
          "name": "Costs"
         }
        ]
       }
      ]
     }
    ],
    "sliders": [
     {
      "canvas": "Shop",
      "name": "Price",
      "periods": {
       "mode": "all"
      },
      "mode": "set",
      "min": 5,
      "max": 15,
      "step": 0.5
     },
     {
      "canvas": "Shop",
      "name": "Volume",
      "periods": {
       "mode": "all"
      },
      "mode": "shift",
      "min": -50,
      "max": 50,
      "step": 1
     }
    ]
   }
  ]
 },
 "periods": {
  "mode": "range",
  "from": 0,
  "to": 2
 },
 "excel": {
  "file": "{model} workbook.xlsx"
 },
 "auto": {
  "sliders": "inputs",
  "bars": "outputs",
  "range": 20
 }
}
